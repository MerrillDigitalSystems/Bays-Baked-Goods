# Admin panel for Bailey (/admin). Unset = admin disabled. 8+ characters.
# Changing it logs out every signed-in device.
ADMIN_PASSWORD=

# Stripe (payments) - required for online checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

